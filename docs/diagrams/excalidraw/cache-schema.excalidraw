      "updated": 1714377600000,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Invalidation matrix\n  • --force                       → bypass reads, still writes (whole run)\n  • --no-cache                    → composition root passes cache_port=None (no R/W)\n  • spectra version bump          → row mismatches via spectra_version field (whole repo)\n  • model / prompt / schema bump  → row mismatches via the corresponding key field\n  • file content change           → new blake2b → new file_hash / new batch_id\n  • file deleted                  → repo_signature changes → full_report_cache miss\n  • >N days old                   → lazy GC via Phase 4 'spectra cache prune'",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Invalidation matrix\n  • --force                       → bypass reads, still writes (whole run)\n  • --no-cache                    → composition root passes cache_port=None (no R/W)\n  • spectra version bump          → row mismatches via spectra_version field (whole repo)\n  • model / prompt / schema bump  → row mismatches via the corresponding key field\n  • file content change           → new blake2b → new file_hash / new batch_id\n  • file deleted                  → repo_signature changes → full_report_cache miss\n  • >N days old                   → lazy GC via Phase 4 'spectra cache prune'",
      "lineHeight": 1.3,
      "baseline": 12
    }
