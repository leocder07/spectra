<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:;">
    <title>Spectra Report — {{ report.repo_name }}</title>
    {% if has_mermaid %}
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@10.9.5/dist/mermaid.min.js"
            integrity="sha384-enVdc7lTHDGtpROV85t9+VqPC2EyyB0hsRD0MrvQnHUsHmTHIz2D8SPP4EnBkstH"
            crossorigin="anonymous"></script>
    <script>document.addEventListener('DOMContentLoaded', function() { if (window.mermaid) mermaid.initialize({startOnLoad: true, theme: 'dark'}); });</script>
    {% endif %}
    <style>
        :root {
            --violet: #7C3AED;
            --violet-light: #8B5CF6;
            --amber: #F59E0B;
            --red: #EF4444;
            --green: #22C55E;
            --cyan: #06B6D4;
            --gray: #6B7280;
            --gray-light: #9CA3AF;
            --gray-dark: #374151;
            --bg: #0F172A;
            --bg-card: #1E293B;
            --bg-card-alt: #283548;
            --text: #F1F5F9;
            --text-muted: #94A3B8;
            --border: #334155;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            padding: 2rem;
        }

        /* [7] Widen container */
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* Header */
        .header {
            text-align: center;
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--violet);
        }

        /* [5] Gradient Wordmark */
        .header h1 {
            font-size: 2.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--violet) 0%, var(--violet-light) 50%, var(--amber) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 0.08em;
            margin-bottom: 0.25rem;
        }

        .header .repo-name {
            font-size: 1.1rem;
            color: var(--text-muted);
        }

        .header .tagline {
            font-size: 0.85rem;
            color: var(--gray);
            margin-top: 0.5rem;
        }

        /* [3] Sticky Section Navigation */
        .section-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            padding: 0.6rem 0;
            margin-bottom: 2rem;
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .section-nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 6px;
            transition: background 0.2s, color 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .section-nav a:hover {
            background: var(--bg-card-alt);
            color: var(--violet-light);
        }

        /* Executive Summary */
        .executive-summary {
            background: var(--bg-card);
            border: 1px solid var(--violet);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .executive-summary h2 {
            font-size: 0.85rem;
            color: var(--violet-light);
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .verdict {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: var(--text);
        }

        .summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .summary-col h3 {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

        .strengths h3 { color: var(--green); }
        .concerns h3 { color: var(--amber); }

        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 0.35rem 0;
            font-size: 0.9rem;
        }

        .summary-dim { color: var(--text); }

        .summary-score { font-weight: 600; }

        .critical-alert {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid var(--red);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            color: var(--red);
            font-weight: 700;
            text-align: center;
            margin-bottom: 1rem;
        }

        /* [4] Severity Distribution Bar */
        .severity-bar-container {
            margin-bottom: 1rem;
        }

        .severity-bar-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
        }

        .severity-bar {
            display: flex;
            height: 24px;
            border-radius: 6px;
            overflow: hidden;
            background: var(--border);
        }

        .severity-bar .seg {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 700;
            color: white;
            min-width: 0;
            transition: width 0.4s ease;
        }

        .seg-critical { background: var(--red); }
        .seg-high { background: #F97316; }
        .seg-medium { background: var(--amber); color: #1E293B !important; }
        .seg-low { background: var(--cyan); color: #1E293B !important; }
        .seg-info { background: var(--gray); }

        .severity-bar-legend {
            display: flex;
            gap: 1rem;
            margin-top: 0.4rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 2px;
        }

        .quick-stats {
            text-align: center;
            color: var(--gray-light);
            font-size: 0.85rem;
        }

        /* ScoreCard */
        .scorecard {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .overall {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        /* [2] Circular Grade Gauge */
        .grade-gauge {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.5rem;
            position: relative;
        }

        .grade-gauge-letter {
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 1;
        }

        .grade-gauge-score {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-top: 0.15rem;
        }

        .dimensions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
        }

        .dim-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: var(--bg-card-alt);
            border-radius: 8px;
        }

        .dim-label {
            min-width: 120px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .dim-bar {
            flex: 1;
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
        }

        /* [6] Animate Score Bars */
        .dim-bar-fill {
            height: 100%;
            border-radius: 4px;
            width: 0;
            animation: fillBar 1s ease-out forwards;
        }

        @keyframes fillBar {
            from { width: 0; }
            to { width: var(--target-width); }
        }

        .dim-score {
            font-weight: 700;
            min-width: 28px;
            text-align: right;
        }

        .dim-grade {
            font-weight: 800;
            min-width: 24px;
            text-align: center;
        }

        /* Grade colors */
        .grade-a { color: var(--green); }
        .grade-b { color: var(--cyan); }
        .grade-c { color: var(--amber); }
        .grade-d, .grade-f { color: var(--red); }

        .bar-a { background: var(--green); }
        .bar-b { background: var(--cyan); }
        .bar-c { background: var(--amber); }
        .bar-d, .bar-f { background: var(--red); }

        /* Stats strip */
        .stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .stat {
            text-align: center;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--violet-light);
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--gray-light);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Degraded banner */
        .degraded-banner {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid var(--amber);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 2rem;
            color: var(--amber);
            font-weight: 600;
        }

        /* Findings */
        .findings-section {
            margin-bottom: 2rem;
        }

        .findings-section h2 {
            font-size: 1.3rem;
            color: var(--violet-light);
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--border);
        }

        /* [1] Collapsible Findings */
        .finding {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 0.75rem;
            border-left: 3px solid var(--border);
            cursor: pointer;
        }

        .finding.severity-critical { border-left-color: var(--red); }
        .finding.severity-high { border-left-color: #F97316; }
        .finding.severity-medium { border-left-color: var(--amber); }
        .finding.severity-low { border-left-color: var(--cyan); }
        .finding.severity-info { border-left-color: var(--gray); }

        .finding-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .finding-title {
            font-weight: 700;
            font-size: 0.95rem;
        }

        .finding-chevron {
            margin-left: auto;
            font-size: 0.75rem;
            color: var(--gray-light);
            transition: transform 0.2s;
        }

        .finding.expanded .finding-chevron {
            transform: rotate(90deg);
        }

        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .badge-critical { background: var(--red); color: white; }
        .badge-high { background: #F97316; color: white; }
        .badge-medium { background: var(--amber); color: #1E293B; }
        .badge-low { background: var(--cyan); color: #1E293B; }
        .badge-info { background: var(--gray); color: white; }

        .finding-location {
            font-size: 0.8rem;
            color: var(--gray-light);
            font-family: 'SF Mono', 'Fira Code', monospace;
            margin-top: 0.4rem;
        }

        .finding-body {
            display: none;
            margin-top: 0.75rem;
        }

        .finding.expanded .finding-body {
            display: block;
        }

        .finding-description {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
        }

        .finding-recommendation {
            font-size: 0.85rem;
            padding: 0.5rem 0.75rem;
            background: rgba(124, 58, 237, 0.1);
            border-radius: 6px;
            color: var(--text);
        }

        .finding-recommendation strong {
            color: var(--violet-light);
        }

        /* Validated badge */
        .validated-badge {
            font-size: 0.7rem;
            color: var(--green);
            font-weight: 600;
        }

        /* Footer */
        .footer {
            text-align: center;
            padding-top: 1.5rem;
            margin-top: 1rem;
            border-top: 1px solid var(--border);
            color: var(--gray);
            font-size: 0.8rem;
        }

        .footer a {
            color: var(--violet-light);
            text-decoration: none;
        }

        .footer .timestamp {
            margin-top: 0.25rem;
            font-size: 0.75rem;
            color: var(--gray-dark);
        }

        /* Spectrum Bar */
        .spectrum-bar {
            display: flex;
            border-radius: 8px;
            overflow: hidden;
            margin: 1rem 0 1.5rem;
            height: 36px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .spectrum-seg {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.25rem;
            color: white;
            text-shadow: 0 1px 2px rgba(0,0,0,0.3);
            transition: opacity 0.2s;
        }

        .spectrum-seg:hover { opacity: 0.85; }

        /* Inline Badge */
        .header-badge {
            position: absolute;
            top: 0;
            right: 0;
        }

        .header-inner {
            position: relative;
        }

        /* Priority Actions */
        .priority-actions {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-left: 3px solid var(--violet);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .priority-actions h2 {
            font-size: 1.1rem;
            color: var(--violet-light);
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .priority-actions ol {
            list-style: none;
            counter-reset: actions;
            padding: 0;
        }

        .priority-actions li {
            counter-increment: actions;
            padding: 0.75rem 0 0.75rem 2.5rem;
            position: relative;
            border-bottom: 1px solid var(--border);
        }

        .priority-actions li:last-child {
            border-bottom: none;
        }

        .priority-actions li::before {
            content: counter(actions);
            position: absolute;
            left: 0;
            top: 0.75rem;
            width: 1.75rem;
            height: 1.75rem;
            background: var(--violet);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: white;
        }

        .action-location {
            display: block;
            font-size: 0.8rem;
            color: var(--gray-light);
            font-family: 'SF Mono', 'Fira Code', monospace;
            margin-top: 0.25rem;
        }

        .action-rec {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.35rem;
        }

        /* Responsive */
        @media (max-width: 600px) {
            body { padding: 1rem; }
            .scorecard { padding: 1rem; }
            .executive-summary { padding: 1rem; }
            .dimensions { grid-template-columns: 1fr; }
            .summary-grid { grid-template-columns: 1fr; }
            .stats { gap: 1rem; }
            .section-nav { gap: 0.25rem; }
            .section-nav a { font-size: 0.7rem; padding: 0.25rem 0.5rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header" id="top">
            <div class="header-inner">
                <div class="header-badge">{{ badge_svg | safe }}</div>
                <h1>SPECTRA</h1>
                <div class="repo-name">{{ report.repo_name }}</div>
                <div class="tagline">The full spectrum of your codebase</div>
            </div>
        </header>

        <!-- Spectrum Bar -->
        <div class="spectrum-bar">
            {% for seg in spectrum_segments %}
            <div class="spectrum-seg" style="width: {{ seg.weight_pct }}%; background: {{ seg.color }};">
                {{ seg.label }} {{ seg.score }} {{ seg.grade }}
            </div>
            {% endfor %}
        </div>

        <!-- [3] Sticky Section Navigation -->
        <nav class="section-nav">
            <a href="#summary">Summary</a>
            {% if top_findings %}<a href="#actions">Actions</a>{% endif %}
            <a href="#scores">Scores</a>
            {% for dimension in dimensions_order %}
            {% set dim_findings = report.findings | selectattr('dimension', 'equalto', dimension) | list %}
            {% if dim_findings %}
            <a href="#dim-{{ dimension }}">{{ _dim_label(dimension) }}</a>
            {% endif %}
            {% endfor %}
        </nav>

        {% if report.is_degraded %}
        <div class="degraded-banner">
            ⚠ Degraded analysis — missing dimensions: {{ report.degraded_dimensions | join(', ') }}
        </div>
        {% endif %}

        <!-- Executive Summary -->
        <section class="executive-summary" id="summary">
            <h2>Executive Summary</h2>
            <div class="verdict">{{ summary.verdict }}</div>

            <div class="summary-grid">
                <div class="summary-col strengths">
                    <h3>Top Strengths</h3>
                    {% for dim in summary.strengths %}
                    <div class="summary-item">
                        <span class="summary-dim">{{ _dim_label(dim.dimension) }}</span>
                        <span class="summary-score {{ _grade_class(dim.grade) }}">{{ dim.grade }} ({{ dim.score | round(0) | int }})</span>
                    </div>
                    {% endfor %}
                </div>

                <div class="summary-col concerns">
                    <h3>Key Concerns</h3>
                    {% for dim in summary.concerns %}
                    <div class="summary-item">
                        <span class="summary-dim">{{ _dim_label(dim.dimension) }}</span>
                        <span class="summary-score {{ _grade_class(dim.grade) }}">{{ dim.grade }} ({{ dim.score | round(0) | int }})</span>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {% if summary.critical_count > 0 %}
            <div class="critical-alert">
                {{ summary.critical_count }} critical issue{{ "s" if summary.critical_count != 1 else "" }} require{{ "s" if summary.critical_count == 1 else "" }} immediate attention
            </div>
            {% endif %}

            <!-- [4] Severity Distribution Bar -->
            {% set dist = summary.severity_dist %}
            {% set total = summary.total_findings %}
            {% if total > 0 %}
            <div class="severity-bar-container">
                <div class="severity-bar-label">Severity Distribution</div>
                <div class="severity-bar">
                    {% for sev in ["critical", "high", "medium", "low", "info"] %}
                    {% if dist[sev] > 0 %}
                    <div class="seg seg-{{ sev }}" style="width: {{ (dist[sev] / total * 100) | round(1) }}%">
                        {{ dist[sev] }}
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
                <div class="severity-bar-legend">
                    {% for sev, color in [("critical", "var(--red)"), ("high", "#F97316"), ("medium", "var(--amber)"), ("low", "var(--cyan)"), ("info", "var(--gray)")] %}
                    {% if dist[sev] > 0 %}
                    <span class="legend-item">
                        <span class="legend-dot" style="background: {{ color }}"></span>
                        {{ sev }} ({{ dist[sev] }})
                    </span>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <div class="quick-stats">
                {{ summary.total_findings }} findings · {{ summary.agents_count }} agents · {{ summary.duration | round(0) | int }}s analysis{% if summary.total_tech_debt_hours > 0 %} · Total tech debt: ~{{ summary.total_tech_debt_hours | round(0) | int }}h{% endif %}
            </div>
        </section>

        <!-- Priority Actions -->
        {% if top_findings %}
        <section id="actions" class="priority-actions">
            <h2>What to Fix First</h2>
            <ol>
                {% for finding in top_findings[:5] %}
                <li>
                    <span class="badge badge-{{ finding.severity }}">{{ finding.severity }}</span>
                    <strong>{{ finding.title }}</strong>
                    <span class="action-location">{{ finding.location.file_path }}{% if finding.location.line_start %}:{{ finding.location.line_start }}{% endif %}</span>
                    <p class="action-rec">{{ finding.recommendation }}</p>
                </li>
                {% endfor %}
            </ol>
        </section>
        {% endif %}

        <!-- ScoreCard -->
        <section class="scorecard" id="scores">
            <div class="overall">
                <!-- [2] Circular Grade Gauge -->
                {% set score_pct = report.score_card.overall_score %}
                {% set grade_cls = _grade_class(report.score_card.overall_grade) %}
                {% if grade_cls == 'grade-a' %}{% set gauge_color = 'var(--green)' %}
                {% elif grade_cls == 'grade-b' %}{% set gauge_color = 'var(--cyan)' %}
                {% elif grade_cls == 'grade-c' %}{% set gauge_color = 'var(--amber)' %}
                {% else %}{% set gauge_color = 'var(--red)' %}{% endif %}
                <div class="grade-gauge"
                     style="background: conic-gradient({{ gauge_color }} {{ (score_pct * 3.6) | round(1) }}deg, var(--border) 0deg);">
                    <div style="width: 110px; height: 110px; border-radius: 50%; background: var(--bg-card); display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <span class="grade-gauge-letter {{ grade_cls }}">{{ report.score_card.overall_grade }}</span>
                        <span class="grade-gauge-score">{{ score_pct | round(0) | int }} / 100</span>
                    </div>
                </div>
            </div>

            <div class="dimensions">
                {% for dim in report.score_card.dimensions %}
                <div class="dim-row">
                    <span class="dim-label">{{ _dim_label(dim.dimension) }}</span>
                    <div class="dim-bar">
                        <!-- [6] Animate Score Bars via CSS custom property -->
                        <div class="dim-bar-fill {{ _bar_class(dim.grade) }}"
                             style="--target-width: {{ dim.score }}%"></div>
                    </div>
                    <span class="dim-score">{{ dim.score | round(0) | int }}</span>
                    <span class="dim-grade {{ _grade_class(dim.grade) }}">{{ dim.grade }}</span>
                </div>
                {% endfor %}
            </div>

            <div class="stats">
                <div class="stat">
                    <div class="stat-value">{{ report.findings | length }}</div>
                    <div class="stat-label">Findings</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ _critical_count(report.findings) }}</div>
                    <div class="stat-label">Critical</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ report.analysis_duration_seconds | round(0) | int }}s</div>
                    <div class="stat-label">Duration</div>
                </div>
                <div class="stat">
                    <div class="stat-value">${{ "%.2f" | format(report.total_cost_usd) }}</div>
                    <div class="stat-label">Cost</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ report.agents_used | length }}</div>
                    <div class="stat-label">Agents</div>
                </div>
            </div>
        </section>

        <!-- Findings by Dimension -->
        {% for dimension in dimensions_order %}
        {% set dim_findings = report.findings | selectattr('dimension', 'equalto', dimension) | list %}
        {% if dim_findings %}
        <section class="findings-section" id="dim-{{ dimension }}">
            <h2>{{ _dim_label(dimension) }} ({{ dim_findings | length }})</h2>

            {% for finding in _sort_by_severity(dim_findings) %}
            <!-- [1] Collapsible Findings -->
            <div class="finding severity-{{ finding.severity }}" onclick="this.classList.toggle('expanded')">
                <div class="finding-header">
                    <span class="badge badge-{{ finding.severity }}">{{ finding.severity }}</span>
                    <span class="finding-title">{{ finding.title }}</span>
                    {% if finding.estimated_hours > 0 %}
                    <span class="validated-badge" style="color: var(--amber);">~{{ finding.estimated_hours | round(1) }}h</span>
                    {% endif %}
                    {% if finding.validated_by_critique %}
                    <span class="validated-badge">✓ Validated</span>
                    {% endif %}
                    <span class="finding-chevron">▶</span>
                </div>
                <div class="finding-location">
                    {{ finding.location.file_path }}{% if finding.location.line_start %}:{{ finding.location.line_start }}{% endif %}{% if finding.location.line_end %}-{{ finding.location.line_end }}{% endif %}
                </div>
                <div class="finding-body">
                    <div class="finding-description">{{ finding.description }}</div>
                    <div class="finding-recommendation">
                        <strong>Recommendation:</strong> {{ finding.recommendation }}
                    </div>
                </div>
            </div>
            {% endfor %}
            {% set dim_hours = summary.dimension_hours.get(dimension, 0) if summary.dimension_hours is defined else 0 %}
            {% if dim_hours > 0 %}
            <div style="text-align: right; padding: 0.5rem 0; font-size: 0.85rem; color: var(--amber); font-weight: 600;">
                Estimated effort: ~{{ dim_hours | round(0) | int }}h
            </div>
            {% endif %}
        </section>
        {% endif %}
        {% endfor %}

        <!-- Footer -->
        <footer class="footer">
            <p>Generated by <a href="https://github.com/spectra-cli/spectra">Spectra</a> — 8 AI agents, 6 dimensions, {{ report.analysis_duration_seconds | round(0) | int }} seconds</p>
            <p>{{ report.repo_url }}</p>
            <p class="timestamp">{{ generated_at }}</p>
        </footer>
    </div>
</body>
</html>
