<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:;">
    <title>Spectra — {{ report.repo_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {% if has_mermaid %}
    <script defer src="https://cdn.jsdelivr.net/npm/mermaid@10.9.5/dist/mermaid.min.js"
            integrity="sha384-enVdc7lTHDGtpROV85t9+VqPC2EyyB0hsRD0MrvQnHUsHmTHIz2D8SPP4EnBkstH"
            crossorigin="anonymous"></script>
    <script>document.addEventListener('DOMContentLoaded', function() { if (window.mermaid) mermaid.initialize({startOnLoad: true, theme: 'dark'}); });</script>
    {% endif %}
    <style>
        /* ═══════════════════════════════════════════════════════
           SPECTRA — Premium Report Theme
           Vercel × Linear × Terminal aesthetic
           ═══════════════════════════════════════════════════════ */

        /* ─── Custom Properties ─── */
        :root {
            /* Surfaces */
            --bg:             #09090b;
            --bg-surface:     #111113;
            --bg-elevated:    #1a1a1f;
            --bg-inset:       #0d0d0f;

            /* Brand */
            --violet:         #7C3AED;
            --violet-light:   #a78bfa;
            --violet-dim:     #6d28d9;
            --violet-glow:    rgba(124, 58, 237, 0.25);

            /* Semantic */
            --amber:          #F59E0B;
            --amber-glow:     rgba(245, 158, 11, 0.2);
            --red:            #EF4444;
            --red-glow:       rgba(239, 68, 68, 0.2);
            --green:          #22C55E;
            --green-glow:     rgba(34, 197, 94, 0.2);
            --cyan:           #06B6D4;
            --orange:         #F97316;

            /* Text */
            --text:           #ededed;
            --text-secondary: #a1a1aa;
            --text-tertiary:  #52525b;

            /* Borders */
            --border:         rgba(255, 255, 255, 0.07);
            --border-subtle:  rgba(255, 255, 255, 0.04);

            /* Glass */
            --glass-border:   rgba(255, 255, 255, 0.06);

            /* Typography */
            --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', 'SF Mono', 'Cascadia Code', 'Fira Code', monospace;
        }

        /* ─── Reset ─── */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        /* ─── Base ─── */
        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            position: relative;
            min-height: 100vh;
        }

        /* ─── Noise Texture ─── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            opacity: 0.025;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            background-size: 256px 256px;
        }

        /* ─── Container ─── */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        /* ─── Header ─── */
        .header {
            text-align: center;
            padding: 3rem 2rem 2rem;
            position: relative;
            overflow: visible;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -60%;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 400px;
            background: radial-gradient(ellipse at center, var(--violet-glow) 0%, transparent 70%);
            pointer-events: none;
            z-index: -1;
        }

        .header-inner { position: relative; }

        .header-badge {
            position: absolute;
            top: 0;
            right: 0;
        }

        .wordmark {
            font-family: var(--font-mono);
            font-size: 2.8rem;
            font-weight: 800;
            letter-spacing: 0.18em;
            background: linear-gradient(135deg, var(--violet) 0%, var(--violet-light) 40%, var(--amber) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 30px var(--violet-glow));
            margin-bottom: 0.75rem;
        }

        .repo-line {
            font-family: var(--font-mono);
            font-size: 0.9rem;
            color: var(--text-secondary);
            letter-spacing: 0.02em;
        }

        .repo-line .prompt { color: var(--violet-light); }

        .tagline {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-tertiary);
            margin-top: 0.5rem;
            letter-spacing: 0.04em;
        }

        /* ─── Spectrum Bar ─── */
        .spectrum-bar-wrapper { padding: 0.5rem 0 1.5rem; }

        .spectrum-bar {
            display: flex;
            border-radius: 8px;
            overflow: hidden;
            height: 40px;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 600;
        }

        .spectrum-seg {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.3rem;
            color: white;
            text-shadow: 0 1px 3px rgba(0,0,0,0.5);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .spectrum-seg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, transparent 50%);
            pointer-events: none;
        }

        .spectrum-seg:hover {
            filter: brightness(1.15);
            z-index: 2;
        }

        /* ─── Sticky Nav (Frosted Glass) ─── */
        .section-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(9, 9, 11, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 0.7rem 0;
            margin-bottom: 2rem;
            display: flex;
            gap: 0.25rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .section-nav a {
            font-family: var(--font-mono);
            color: var(--text-tertiary);
            text-decoration: none;
            font-size: 0.72rem;
            font-weight: 500;
            padding: 0.35rem 0.75rem;
            border-radius: 6px;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .section-nav a:hover {
            background: rgba(124, 58, 237, 0.1);
            color: var(--violet-light);
        }

        /* ─── Section Label ─── */
        .section-label {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--violet-light);
            margin-bottom: 1.25rem;
        }

        /* ─── Executive Summary ─── */
        .executive-summary {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
        }

        .executive-summary::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--violet), transparent);
        }

        .verdict {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 1.75rem;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 1.75rem;
        }

        .summary-col h3 {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--border-subtle);
        }

        .strengths h3 { color: var(--green); }
        .concerns h3 { color: var(--amber); }

        .summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.4rem 0;
            font-size: 0.85rem;
        }

        .summary-dim { color: var(--text-secondary); }

        .summary-score {
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.8rem;
        }

        .critical-alert {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            padding: 0.75rem 1.25rem;
            color: var(--red);
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: center;
            margin-bottom: 1.25rem;
        }

        /* ─── Severity Distribution ─── */
        .severity-bar-container { margin-bottom: 1.25rem; }

        .severity-bar-label {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-tertiary);
            margin-bottom: 0.5rem;
        }

        .severity-bar {
            display: flex;
            height: 6px;
            border-radius: 3px;
            overflow: hidden;
            background: var(--bg-elevated);
        }

        .severity-bar .seg {
            height: 100%;
            min-width: 0;
            transition: width 0.6s ease;
        }

        .seg-critical { background: var(--red); }
        .seg-high { background: var(--orange); }
        .seg-medium { background: var(--amber); }
        .seg-low { background: var(--cyan); }
        .seg-info { background: var(--text-tertiary); }

        .severity-bar-legend {
            display: flex;
            gap: 1rem;
            margin-top: 0.5rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--text-tertiary);
        }

        .legend-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .quick-stats {
            text-align: center;
            font-family: var(--font-mono);
            color: var(--text-tertiary);
            font-size: 0.75rem;
            letter-spacing: 0.02em;
        }

        .sep { opacity: 0.4; }

        /* ─── Priority Actions ─── */
        .priority-actions {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
        }

        .priority-actions::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--amber), transparent);
        }

        .priority-actions ol { list-style: none; padding: 0; }

        .priority-actions li {
            padding: 1rem 0 1rem 3.5rem;
            position: relative;
            border-bottom: 1px solid var(--border-subtle);
            transition: background 0.2s ease;
        }

        .priority-actions li:last-child { border-bottom: none; }

        .priority-actions li:hover { background: rgba(245, 158, 11, 0.03); }

        .action-num {
            position: absolute;
            left: 0;
            top: 1rem;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-tertiary);
        }

        .action-num .arrow { color: var(--amber); }

        .action-title {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text);
        }

        .action-location {
            display: block;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-tertiary);
            margin-top: 0.3rem;
        }

        .action-rec {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 0.35rem;
        }

        /* ─── ScoreCard ─── */
        .scorecard {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2.5rem 2rem;
            margin-bottom: 2rem;
        }

        .overall {
            text-align: center;
            margin-bottom: 2rem;
        }

        /* Grade Gauge with Glow */
        .grade-gauge {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.75rem;
            position: relative;
            animation: gaugeGlow 3s ease-in-out infinite;
        }

        @keyframes gaugeGlow {
            0%, 100% { filter: drop-shadow(0 0 20px var(--gauge-glow)); }
            50% { filter: drop-shadow(0 0 35px var(--gauge-glow)); }
        }

        .grade-gauge-inner {
            width: 126px;
            height: 126px;
            border-radius: 50%;
            background: var(--bg-surface);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .grade-gauge-letter {
            font-family: var(--font-mono);
            font-size: 3rem;
            font-weight: 800;
            line-height: 1;
        }

        .grade-gauge-score {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-tertiary);
            margin-top: 0.2rem;
        }

        /* Dimensions */
        .dimensions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 0.5rem;
        }

        .dim-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            transition: background 0.2s ease;
        }

        .dim-row:hover { background: var(--bg-elevated); }

        .dim-label {
            font-family: var(--font-mono);
            min-width: 130px;
            font-weight: 500;
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        .dim-bar {
            flex: 1;
            height: 4px;
            background: var(--bg-elevated);
            border-radius: 2px;
            overflow: hidden;
        }

        .dim-bar-fill {
            height: 100%;
            border-radius: 2px;
            width: 0;
            animation: fillBar 1.2s ease-out forwards;
        }

        @keyframes fillBar {
            from { width: 0; }
            to { width: var(--target-width); }
        }

        .dim-score {
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.8rem;
            min-width: 28px;
            text-align: right;
            color: var(--text-secondary);
        }

        .dim-grade {
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 0.8rem;
            min-width: 28px;
            text-align: center;
        }

        /* Grade Colors */
        .grade-a { color: var(--green); }
        .grade-b { color: var(--cyan); }
        .grade-c { color: var(--amber); }
        .grade-d, .grade-f { color: var(--red); }

        .bar-a { background: var(--green); box-shadow: 0 0 8px var(--green-glow); }
        .bar-b { background: var(--cyan); box-shadow: 0 0 8px rgba(6, 182, 212, 0.2); }
        .bar-c { background: var(--amber); box-shadow: 0 0 8px var(--amber-glow); }
        .bar-d, .bar-f { background: var(--red); box-shadow: 0 0 8px var(--red-glow); }

        /* Stats */
        .stats {
            display: flex;
            justify-content: center;
            gap: 2.5rem;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .stat { text-align: center; }

        .stat-value {
            font-family: var(--font-mono);
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--violet-light);
        }

        .stat-label {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-top: 0.15rem;
        }

        /* Degraded Banner */
        .degraded-banner {
            background: rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 8px;
            padding: 0.75rem 1.25rem;
            margin-bottom: 2rem;
            color: var(--amber);
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 0.85rem;
        }

        /* ─── Findings ─── */
        .findings-section { margin-bottom: 2.5rem; }

        .findings-section h2 {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border);
            letter-spacing: 0.02em;
        }

        .findings-section h2 .dim-count {
            color: var(--text-tertiary);
            font-weight: 400;
        }

        .finding {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 0.5rem;
            border-left: 2px solid var(--border);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .finding:hover {
            border-color: var(--glass-border);
            background: rgba(255, 255, 255, 0.025);
        }

        .finding.severity-critical { border-left-color: var(--red); }
        .finding.severity-high { border-left-color: var(--orange); }
        .finding.severity-medium { border-left-color: var(--amber); }
        .finding.severity-low { border-left-color: var(--cyan); }
        .finding.severity-info { border-left-color: var(--text-tertiary); }

        .finding-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .finding-title {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text);
        }

        .finding-chevron {
            margin-left: auto;
            font-size: 0.65rem;
            color: var(--text-tertiary);
            transition: transform 0.2s ease;
            font-family: var(--font-mono);
        }

        .finding.expanded .finding-chevron { transform: rotate(90deg); }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .badge-critical { background: rgba(239, 68, 68, 0.15); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.3); }
        .badge-high { background: rgba(249, 115, 22, 0.15); color: var(--orange); border: 1px solid rgba(249, 115, 22, 0.3); }
        .badge-medium { background: rgba(245, 158, 11, 0.15); color: var(--amber); border: 1px solid rgba(245, 158, 11, 0.3); }
        .badge-low { background: rgba(6, 182, 212, 0.15); color: var(--cyan); border: 1px solid rgba(6, 182, 212, 0.3); }
        .badge-info { background: rgba(161, 161, 170, 0.1); color: var(--text-tertiary); border: 1px solid rgba(161, 161, 170, 0.2); }

        .finding-location {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-tertiary);
            margin-top: 0.4rem;
        }

        .finding-location::before {
            content: '> ';
            color: var(--violet-dim);
        }

        .finding-body {
            display: none;
            margin-top: 1rem;
            padding-top: 0.75rem;
            border-top: 1px solid var(--border-subtle);
        }

        .finding.expanded .finding-body { display: block; }

        .finding-description {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 0.75rem;
            line-height: 1.7;
        }

        .finding-recommendation {
            font-size: 0.8rem;
            padding: 0.75rem 1rem;
            background: rgba(124, 58, 237, 0.05);
            border: 1px solid rgba(124, 58, 237, 0.1);
            border-radius: 6px;
            color: var(--text-secondary);
            font-family: var(--font-mono);
            line-height: 1.6;
        }

        .finding-recommendation strong { color: var(--violet-light); font-weight: 600; }

        .validated-badge {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--green);
            font-weight: 600;
        }

        .hours-badge {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--amber);
            font-weight: 600;
        }

        .dim-effort {
            text-align: right;
            padding: 0.5rem 0;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--amber);
            font-weight: 500;
        }

        /* ─── Tech Debt & DD Compliance ─── */
        .dd-section {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
        }

        .dd-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--cyan), transparent);
        }

        .dd-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 1.25rem;
        }

        .dd-stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .dd-stat-row:last-child { border-bottom: none; }

        .dd-stat-label {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-secondary);
            text-transform: capitalize;
        }

        .dd-stat-value {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text);
        }

        .dd-bar-track {
            height: 20px;
            background: var(--bg-elevated);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 0.4rem;
            display: flex;
        }

        .dd-bar-fill {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-mono);
            font-size: 0.6rem;
            font-weight: 700;
            color: white;
            min-width: 0;
            transition: width 0.6s ease;
        }

        .dd-headline {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }

        .dd-headline-num {
            font-family: var(--font-mono);
            font-size: 2rem;
            font-weight: 800;
            color: var(--amber);
        }

        .dd-headline-unit {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .dd-cost {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-tertiary);
            margin-bottom: 1.25rem;
        }

        .owasp-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 0.4rem;
            margin-top: 0.75rem;
        }

        .owasp-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.6rem;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 0.72rem;
        }

        .owasp-item.covered {
            background: rgba(34, 197, 94, 0.06);
            color: var(--green);
        }

        .owasp-item.uncovered {
            background: rgba(161, 161, 170, 0.04);
            color: var(--text-tertiary);
        }

        .owasp-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .owasp-item.covered .owasp-dot { background: var(--green); }
        .owasp-item.uncovered .owasp-dot { background: var(--text-tertiary); opacity: 0.4; }

        .cwe-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-top: 0.75rem;
        }

        .cwe-tag {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            background: rgba(6, 182, 212, 0.08);
            color: var(--cyan);
            border: 1px solid rgba(6, 182, 212, 0.15);
        }

        .dd-subsection-label {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-tertiary);
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .dd-coverage-stat {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }

        @media (max-width: 640px) {
            .dd-grid { grid-template-columns: 1fr; }
            .owasp-grid { grid-template-columns: 1fr; }
        }

        /* ─── Footer ─── */
        .footer {
            text-align: center;
            padding: 2rem 0 1.5rem;
            margin-top: 1.5rem;
            border-top: 1px solid var(--border);
        }

        .footer-line {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-tertiary);
            letter-spacing: 0.02em;
        }

        .footer-line a {
            color: var(--violet-light);
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-line a:hover { color: var(--violet); }
        .footer-line + .footer-line { margin-top: 0.3rem; }

        /* ─── Animations ─── */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .container > * { animation: fadeIn 0.4s ease-out both; }
        .container > *:nth-child(1) { animation-delay: 0s; }
        .container > *:nth-child(2) { animation-delay: 0.05s; }
        .container > *:nth-child(3) { animation-delay: 0.1s; }
        .container > *:nth-child(4) { animation-delay: 0.15s; }
        .container > *:nth-child(5) { animation-delay: 0.2s; }
        .container > *:nth-child(6) { animation-delay: 0.25s; }
        .container > *:nth-child(7) { animation-delay: 0.3s; }
        .container > *:nth-child(8) { animation-delay: 0.35s; }

        /* ─── Responsive ─── */
        @media (max-width: 640px) {
            .container { padding: 1rem; }
            .wordmark { font-size: 2rem; }
            .scorecard, .executive-summary, .priority-actions { padding: 1.25rem; }
            .dimensions { grid-template-columns: 1fr; }
            .summary-grid { grid-template-columns: 1fr; }
            .stats { gap: 1.25rem; }
            .section-nav { gap: 0.15rem; }
            .section-nav a { font-size: 0.65rem; padding: 0.25rem 0.5rem; }
            .spectrum-bar { height: 32px; font-size: 0.6rem; }
            .grade-gauge { width: 130px; height: 130px; }
            .grade-gauge-inner { width: 102px; height: 102px; }
            .grade-gauge-letter { font-size: 2.4rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header" id="top">
            <div class="header-inner">
                <div class="header-badge">{{ badge_svg | safe }}</div>
                <h1 class="wordmark">SPECTRA</h1>
                <div class="repo-line">
                    <span class="prompt">&gt;</span> analyzing <strong>{{ report.repo_name }}</strong>
                </div>
                <div class="tagline">the full spectrum of your codebase</div>
            </div>
        </header>

        <!-- Spectrum Bar -->
        <div class="spectrum-bar-wrapper">
            <div class="spectrum-bar">
                {% for seg in spectrum_segments %}
                <div class="spectrum-seg" style="width: {{ seg.weight_pct }}%; background: {{ seg.color }};">
                    {{ seg.label }} {{ seg.score }} {{ seg.grade }}
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Sticky Nav -->
        <nav class="section-nav">
            <a href="#summary">Summary</a>
            {% if top_findings %}<a href="#actions">Actions</a>{% endif %}
            <a href="#scores">Scores</a>
            {% for dimension in dimensions_order %}
            {% set dim_findings = report.findings | selectattr('dimension', 'equalto', dimension) | list %}
            {% if dim_findings %}
            <a href="#dim-{{ dimension }}">{{ _dim_label(dimension) }}</a>
            {% endif %}
            {% endfor %}
            {% if tech_debt and tech_debt.total_hours > 0 %}<a href="#tech-debt">Tech Debt</a>{% endif %}
            {% if dd_compliance %}<a href="#dd-compliance">Compliance</a>{% endif %}
        </nav>

        {% if report.is_degraded %}
        <div class="degraded-banner">
            ⚠ Degraded analysis — missing dimensions: {{ report.degraded_dimensions | join(', ') }}
        </div>
        {% endif %}

        <!-- Executive Summary -->
        <section class="executive-summary" id="summary">
            <div class="section-label">Executive Summary</div>
            <div class="verdict">{{ summary.verdict }}</div>

            <div class="summary-grid">
                <div class="summary-col strengths">
                    <h3>Top Strengths</h3>
                    {% for dim in summary.strengths %}
                    <div class="summary-item">
                        <span class="summary-dim">{{ _dim_label(dim.dimension) }}</span>
                        <span class="summary-score {{ _grade_class(dim.grade) }}">{{ dim.grade }} ({{ dim.score | round(0) | int }})</span>
                    </div>
                    {% endfor %}
                </div>

                <div class="summary-col concerns">
                    <h3>Key Concerns</h3>
                    {% for dim in summary.concerns %}
                    <div class="summary-item">
                        <span class="summary-dim">{{ _dim_label(dim.dimension) }}</span>
                        <span class="summary-score {{ _grade_class(dim.grade) }}">{{ dim.grade }} ({{ dim.score | round(0) | int }})</span>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {% if summary.critical_count > 0 %}
            <div class="critical-alert">
                {{ summary.critical_count }} critical issue{{ "s" if summary.critical_count != 1 else "" }} require{{ "s" if summary.critical_count == 1 else "" }} immediate attention
            </div>
            {% endif %}

            <!-- Severity Distribution -->
            {% set dist = summary.severity_dist %}
            {% set total = summary.total_findings %}
            {% if total > 0 %}
            <div class="severity-bar-container">
                <div class="severity-bar-label">Severity Distribution</div>
                <div class="severity-bar">
                    {% for sev in ["critical", "high", "medium", "low", "info"] %}
                    {% if dist[sev] > 0 %}
                    <div class="seg seg-{{ sev }}" style="width: {{ (dist[sev] / total * 100) | round(1) }}%"></div>
                    {% endif %}
                    {% endfor %}
                </div>
                <div class="severity-bar-legend">
                    {% for sev, color in [("critical", "var(--red)"), ("high", "#F97316"), ("medium", "var(--amber)"), ("low", "var(--cyan)"), ("info", "var(--text-tertiary)")] %}
                    {% if dist[sev] > 0 %}
                    <span class="legend-item">
                        <span class="legend-dot" style="background: {{ color }}"></span>
                        {{ sev }} ({{ dist[sev] }})
                    </span>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <div class="quick-stats">
                {{ summary.total_findings }} findings <span class="sep">&middot;</span> {{ summary.agents_count }} agents <span class="sep">&middot;</span> {{ summary.duration | round(0) | int }}s{% if summary.total_tech_debt_hours > 0 %} <span class="sep">&middot;</span> ~{{ summary.total_tech_debt_hours | round(0) | int }}h tech debt{% endif %}
            </div>
        </section>

        <!-- Priority Actions -->
        {% if top_findings %}
        <section id="actions" class="priority-actions">
            <div class="section-label">What to Fix First</div>
            <ol>
                {% for finding in top_findings[:5] %}
                <li>
                    <span class="action-num">{{ "%02d" | format(loop.index) }}<span class="arrow">&gt;</span></span>
                    <span class="badge badge-{{ finding.severity }}">{{ finding.severity }}</span>
                    <span class="action-title">{{ finding.title }}</span>
                    <span class="action-location">{{ finding.location.file_path }}{% if finding.location.line_start %}:{{ finding.location.line_start }}{% endif %}</span>
                    <p class="action-rec">{{ finding.recommendation }}</p>
                </li>
                {% endfor %}
            </ol>
        </section>
        {% endif %}

        <!-- ScoreCard -->
        <section class="scorecard" id="scores">
            <div class="overall">
                {% set score_pct = report.score_card.overall_score %}
                {% set grade_cls = _grade_class(report.score_card.overall_grade) %}
                {% if grade_cls == 'grade-a' %}{% set gauge_color = 'var(--green)' %}{% set gauge_glow = 'var(--green-glow)' %}
                {% elif grade_cls == 'grade-b' %}{% set gauge_color = 'var(--cyan)' %}{% set gauge_glow = 'rgba(6,182,212,0.2)' %}
                {% elif grade_cls == 'grade-c' %}{% set gauge_color = 'var(--amber)' %}{% set gauge_glow = 'var(--amber-glow)' %}
                {% else %}{% set gauge_color = 'var(--red)' %}{% set gauge_glow = 'var(--red-glow)' %}{% endif %}
                <div class="grade-gauge"
                     style="background: conic-gradient({{ gauge_color }} {{ (score_pct * 3.6) | round(1) }}deg, var(--bg-elevated) 0deg); --gauge-glow: {{ gauge_glow }};">
                    <div class="grade-gauge-inner">
                        <span class="grade-gauge-letter {{ grade_cls }}">{{ report.score_card.overall_grade }}</span>
                        <span class="grade-gauge-score">{{ score_pct | round(0) | int }} / 100</span>
                    </div>
                </div>
            </div>

            <div class="dimensions">
                {% for dim in report.score_card.dimensions %}
                <div class="dim-row">
                    <span class="dim-label">{{ _dim_label(dim.dimension) }}</span>
                    <div class="dim-bar">
                        <div class="dim-bar-fill {{ _bar_class(dim.grade) }}"
                             style="--target-width: {{ dim.score }}%"></div>
                    </div>
                    <span class="dim-score">{{ dim.score | round(0) | int }}</span>
                    <span class="dim-grade {{ _grade_class(dim.grade) }}">{{ dim.grade }}</span>
                </div>
                {% endfor %}
            </div>

            <div class="stats">
                <div class="stat">
                    <div class="stat-value">{{ report.findings | length }}</div>
                    <div class="stat-label">Findings</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ _critical_count(report.findings) }}</div>
                    <div class="stat-label">Critical</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ report.analysis_duration_seconds | round(0) | int }}s</div>
                    <div class="stat-label">Duration</div>
                </div>
                <div class="stat">
                    <div class="stat-value">${{ "%.2f" | format(report.total_cost_usd) }}</div>
                    <div class="stat-label">Cost</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ report.agents_used | length }}</div>
                    <div class="stat-label">Agents</div>
                </div>
            </div>
        </section>

        <!-- Findings by Dimension -->
        {% for dimension in dimensions_order %}
        {% set dim_findings = report.findings | selectattr('dimension', 'equalto', dimension) | list %}
        {% if dim_findings %}
        <section class="findings-section" id="dim-{{ dimension }}">
            <h2>{{ _dim_label(dimension) }} <span class="dim-count">({{ dim_findings | length }})</span></h2>

            {% for finding in _sort_by_severity(dim_findings) %}
            <div class="finding severity-{{ finding.severity }}" onclick="this.classList.toggle('expanded')">
                <div class="finding-header">
                    <span class="badge badge-{{ finding.severity }}">{{ finding.severity }}</span>
                    <span class="finding-title">{{ finding.title }}</span>
                    {% if finding.estimated_hours > 0 %}
                    <span class="hours-badge">~{{ finding.estimated_hours | round(1) }}h</span>
                    {% endif %}
                    {% if finding.validated_by_critique %}
                    <span class="validated-badge">✓ validated</span>
                    {% endif %}
                    <span class="finding-chevron">▶</span>
                </div>
                <div class="finding-location">
                    {{ finding.location.file_path }}{% if finding.location.line_start %}:{{ finding.location.line_start }}{% endif %}{% if finding.location.line_end %}-{{ finding.location.line_end }}{% endif %}
                </div>
                <div class="finding-body">
                    <div class="finding-description">{{ finding.description }}</div>
                    <div class="finding-recommendation">
                        <strong>Recommendation:</strong> {{ finding.recommendation }}
                    </div>
                </div>
            </div>
            {% endfor %}
            {% set dim_hours = summary.dimension_hours.get(dimension, 0) if summary.dimension_hours is defined else 0 %}
            {% if dim_hours > 0 %}
            <div class="dim-effort">
                estimated effort: ~{{ dim_hours | round(0) | int }}h
            </div>
            {% endif %}
        </section>
        {% endif %}
        {% endfor %}

        <!-- Technical Debt Summary -->
        {% if tech_debt and tech_debt.total_hours > 0 %}
        <section class="dd-section" id="tech-debt">
            <div class="section-label">Technical Debt Summary</div>

            <div class="dd-headline">
                <span class="dd-headline-num">{{ tech_debt.total_hours }}</span>
                <span class="dd-headline-unit">estimated hours to remediate</span>
            </div>
            <div class="dd-cost">cost to remediate: ~${{ "{:,.0f}".format(tech_debt.cost_usd) }} at $150/hr avg dev rate</div>

            <div class="dd-grid">
                <div>
                    <div class="dd-subsection-label" style="margin-top: 0;">By Dimension</div>
                    {% set max_dim_hours = tech_debt.by_dimension.values() | max if tech_debt.by_dimension else 1 %}
                    {% for dim, hours in tech_debt.by_dimension.items() | sort(attribute='1', reverse=true) %}
                    <div class="dd-stat-row">
                        <span class="dd-stat-label">{{ _dim_label(dim) }}</span>
                        <span class="dd-stat-value">{{ hours | round(1) }}h</span>
                    </div>
                    {% endfor %}
                </div>
                <div>
                    <div class="dd-subsection-label" style="margin-top: 0;">By Severity</div>
                    {% set sev_colors = {"critical": "var(--red)", "high": "var(--orange)", "medium": "var(--amber)", "low": "var(--cyan)", "info": "var(--text-tertiary)"} %}
                    {% for sev in ["critical", "high", "medium", "low", "info"] %}
                    {% set hours = tech_debt.by_severity.get(sev, 0) %}
                    {% if hours > 0 %}
                    <div class="dd-stat-row">
                        <span class="dd-stat-label" style="color: {{ sev_colors[sev] }};">{{ sev }}</span>
                        <span class="dd-stat-value">{{ hours | round(1) }}h</span>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>

            {% if tech_debt.total_hours > 0 %}
            <div style="margin-top: 1.25rem;">
                <div class="dd-subsection-label" style="margin-top: 0;">Debt Distribution</div>
                <div class="dd-bar-track">
                    {% for sev in ["critical", "high", "medium", "low", "info"] %}
                    {% set hours = tech_debt.by_severity.get(sev, 0) %}
                    {% if hours > 0 %}
                    <div class="dd-bar-fill" style="width: {{ (hours / tech_debt.total_hours * 100) | round(1) }}%; background: {{ sev_colors[sev] }};">
                        {% if hours / tech_debt.total_hours > 0.08 %}{{ sev[:4] }}{% endif %}
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </section>
        {% endif %}

        <!-- DD Compliance Mapping -->
        {% if dd_compliance %}
        <section class="dd-section" id="dd-compliance">
            <div class="section-label">Due Diligence Compliance Mapping</div>

            <div class="dd-subsection-label" style="margin-top: 0;">OWASP Top 10 (2021) Coverage</div>
            <div class="dd-coverage-stat">{{ dd_compliance.owasp_covered_count }} of {{ dd_compliance.owasp_total }} categories checked</div>
            <div class="owasp-grid">
                {% for item in dd_compliance.owasp_coverage %}
                <div class="owasp-item {{ 'covered' if item.covered else 'uncovered' }}">
                    <span class="owasp-dot"></span>
                    {{ item.label }}
                </div>
                {% endfor %}
            </div>

            {% if dd_compliance.cwes %}
            <div class="dd-subsection-label">CWE References Found</div>
            <div class="cwe-list">
                {% for cwe_id in dd_compliance.cwes %}
                <span class="cwe-tag">CWE-{{ cwe_id }}</span>
                {% endfor %}
            </div>
            {% endif %}
        </section>
        {% endif %}

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-line">
                <a href="https://github.com/spectra-cli/spectra">spectra</a>
                <span class="sep"> &middot; </span>{{ report.agents_used | length }} agents
                <span class="sep"> &middot; </span>{{ report.analysis_duration_seconds | round(0) | int }}s
                <span class="sep"> &middot; </span>${{ "%.2f" | format(report.total_cost_usd) }}
            </div>
            <div class="footer-line">{{ report.repo_url }}</div>
            <div class="footer-line" style="opacity: 0.5;">{{ generated_at }}</div>
        </footer>
    </div>
</body>
</html>
