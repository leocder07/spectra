<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'nonce-{{ csp_nonce }}'; style-src 'nonce-{{ csp_nonce }}' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none';">
    <meta name="x-spectra-classification" content="public">
    <title>Spectra — {{ report.repo_name }} — Public Summary</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style nonce="{{ csp_nonce }}">
        :root {
            --bg:             #09090b;
            --bg-surface:     #111113;
            --bg-elevated:    #1a1a1f;
            --violet:         #7C3AED;
            --violet-light:   #a78bfa;
            --violet-glow:    rgba(124, 58, 237, 0.25);
            --amber:          #F59E0B;
            --red:            #EF4444;
            --green:          #22C55E;
            --cyan:           #06B6D4;
            --text:           #ededed;
            --text-secondary: #a1a1aa;
            --text-tertiary:  #71717a;
            --border:         rgba(255, 255, 255, 0.07);
            --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', 'SF Mono', 'Cascadia Code', 'Fira Code', monospace;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
        }

        /* ─── Classification + Disclaimer Banners ─── */
        .classification-banner {
            background: #06B6D4;
            color: #0b0b0d;
            font-family: var(--font-sans);
            font-size: 0.85rem;
            line-height: 1.5;
            padding: 0.7rem 1.25rem;
            text-align: center;
            border-bottom: 1px solid rgba(0, 0, 0, 0.18);
            letter-spacing: 0.02em;
        }
        .classification-banner strong {
            font-family: var(--font-mono);
            font-weight: 700;
            letter-spacing: 0.08em;
        }

        .disclaimer-banner {
            background: #F59E0B;
            color: #0b0b0d;
            font-family: var(--font-sans);
            font-size: 0.85rem;
            line-height: 1.5;
            padding: 0.85rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
        }
        .disclaimer-banner.is-dismissed { display: none; }
        .disclaimer-banner-content { max-width: 1100px; flex: 1; }
        .disclaimer-banner-content strong { font-weight: 700; }
        .disclaimer-banner-content a {
            color: #0b0b0d;
            text-decoration: underline;
            text-underline-offset: 2px;
            font-weight: 600;
        }
        .disclaimer-banner-dismiss {
            background: transparent;
            border: 1px solid rgba(11, 11, 13, 0.35);
            color: #0b0b0d;
            font-family: var(--font-mono);
            font-size: 1rem;
            font-weight: 700;
            line-height: 1;
            padding: 0.35rem 0.6rem;
            border-radius: 4px;
            cursor: pointer;
            flex-shrink: 0;
        }
        .disclaimer-banner-dismiss:hover { background: rgba(11, 11, 13, 0.12); }
        .disclaimer-banner-dismiss:focus-visible {
            outline: 2px solid #0b0b0d;
            outline-offset: 2px;
        }

        /* ─── Public Watermark ─── */
        .spectra-watermark {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .spectra-watermark__text {
            transform: rotate(-30deg);
            font-family: var(--font-mono);
            font-size: 3rem;
            font-weight: 800;
            color: rgba(124, 58, 237, 0.10);
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            user-select: none;
        }

        /* ─── Container + Header ─── */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            padding: 3rem 2rem 2rem;
        }
        .wordmark {
            font-family: var(--font-mono);
            font-size: 2.4rem;
            font-weight: 800;
            letter-spacing: 0.18em;
            background: linear-gradient(135deg, var(--violet) 0%, var(--violet-light) 40%, var(--amber) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 30px var(--violet-glow));
            margin-bottom: 0.75rem;
        }
        .repo-line {
            font-family: var(--font-mono);
            font-size: 0.9rem;
            color: var(--text-secondary);
            letter-spacing: 0.02em;
        }
        .repo-line .prompt { color: var(--violet-light); }
        .tagline {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-tertiary);
            margin-top: 0.5rem;
            letter-spacing: 0.04em;
        }
        .header-badge { margin-top: 1rem; }

        /* ─── Spectrum Bar ─── */
        .spectrum-bar-wrapper { padding: 1rem 0 2rem; }
        .spectrum-bar {
            display: flex;
            border-radius: 8px;
            overflow: hidden;
            height: 40px;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 600;
        }
        .spectrum-seg {
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-shadow: 0 1px 3px rgba(0,0,0,0.5);
        }

        /* ─── ScoreCard ─── */
        .scorecard {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin: 1.5rem 0;
        }
        .scorecard h2 {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--violet-light);
            margin-bottom: 1.5rem;
            letter-spacing: 0.04em;
        }
        .overall-grade {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }
        .overall-grade__label {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-tertiary);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .overall-grade__grade {
            font-family: var(--font-mono);
            font-size: 3.5rem;
            font-weight: 900;
            line-height: 1;
        }
        .overall-grade__score {
            font-family: var(--font-mono);
            font-size: 1.4rem;
            color: var(--text-secondary);
        }
        .grade-a .overall-grade__grade, .grade-a { color: var(--green); }
        .grade-b .overall-grade__grade, .grade-b { color: var(--cyan); }
        .grade-c .overall-grade__grade, .grade-c { color: var(--amber); }
        .grade-d .overall-grade__grade, .grade-d { color: var(--red); }
        .grade-f .overall-grade__grade, .grade-f { color: var(--red); }

        .dim-table {
            width: 100%;
            border-collapse: collapse;
            font-family: var(--font-sans);
        }
        .dim-table th, .dim-table td {
            text-align: left;
            padding: 0.75rem 0.5rem;
            border-bottom: 1px solid var(--border);
        }
        .dim-table th {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-tertiary);
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .dim-table td { color: var(--text-secondary); }
        .dim-table .dim-name { color: var(--text); font-weight: 600; }
        .dim-grade {
            font-family: var(--font-mono);
            font-weight: 700;
        }

        /* ─── Aggregate Stats ─── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0;
        }
        .stat-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.25rem;
        }
        .stat-card__label {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-tertiary);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }
        .stat-card__value {
            font-family: var(--font-mono);
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text);
        }

        /* ─── Redaction Notice ─── */
        .redaction-notice {
            background: var(--bg-surface);
            border: 1px dashed rgba(124, 58, 237, 0.4);
            border-radius: 10px;
            padding: 1.5rem;
            margin: 1.5rem 0;
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.9rem;
            color: var(--text-secondary);
        }
        .redaction-notice strong {
            color: var(--violet-light);
            font-weight: 700;
        }

        /* ─── Footer ─── */
        .footer {
            margin-top: 3rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-tertiary);
        }

        @media print {
            .disclaimer-banner-dismiss { display: none; }
        }
    </style>
</head>
<body>
    <!-- Classification Banner (capability #56) — distinct from disclaimer -->
    <div class="classification-banner" role="note" aria-label="Report classification">
        <strong>PUBLIC SUMMARY</strong> — redacted for sharing. Internal stakeholders should request the confidential report.
    </div>

    <!-- Indicative-Analysis Disclaimer (capability #61) -->
    <div class="disclaimer-banner" id="disclaimer-banner" role="note" aria-label="Analysis disclaimer">
        <div class="disclaimer-banner-content">
            <strong>Indicative analysis — not auditor-grade evidence.</strong>
            Spectra runs 8 LLM agents over your code; findings are heuristic and require human verification before being treated as compliance evidence, audit input, or pass/fail signal in regulated workflows.
            <a href="{{ disclaimer.url }}" rel="noopener">Learn more</a>
        </div>
        <button type="button"
                class="disclaimer-banner-dismiss"
                data-action="dismiss-disclaimer"
                aria-label="Dismiss disclaimer for this session">×</button>
    </div>

    <!-- Diagonal watermark overlay -->
    <div class="spectra-watermark" aria-hidden="true">
        <div class="spectra-watermark__text">{{ watermark.text }}</div>
    </div>

    <div class="container">
        <header class="header" id="top">
            <h1 class="wordmark">SPECTRA</h1>
            <div class="repo-line">
                <span class="prompt">&gt;</span> <strong>{{ report.repo_name }}</strong>
            </div>
            <div class="tagline">public summary · spectra v{{ spectra_version }}</div>
            <div class="header-badge">{{ badge_svg | safe }}</div>
        </header>

        <!-- Spectrum Bar -->
        <div class="spectrum-bar-wrapper">
            <div class="spectrum-bar">
                {% for seg in spectrum_segments %}
                <div class="spectrum-seg" style="width: {{ seg.weight_pct }}%; background: {{ seg.color }};">
                    {{ seg.label }} {{ seg.score }} {{ seg.grade }}
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Overall ScoreCard -->
        <section class="scorecard {{ _grade_class(report.score_card.overall_grade) }}" id="scores">
            <h2>Overall Grade</h2>
            <div class="overall-grade">
                <div>
                    <div class="overall-grade__label">Grade</div>
                    <div class="overall-grade__grade">{{ report.score_card.overall_grade }}</div>
                </div>
                <div>
                    <div class="overall-grade__label">Score</div>
                    <div class="overall-grade__score">{{ report.score_card.overall_score | round(1) }}/100</div>
                </div>
            </div>

            <table class="dim-table">
                <thead>
                    <tr>
                        <th>Dimension</th>
                        <th>Grade</th>
                        <th>Score</th>
                        <th>Weight</th>
                        <th>Findings</th>
                    </tr>
                </thead>
                <tbody>
                    {% for dim in dimension_summaries %}
                    <tr>
                        <td class="dim-name">{{ dim.label }}</td>
                        <td class="dim-grade {{ dim.grade_class }}">{{ dim.grade }}</td>
                        <td>{{ dim.score }}/100</td>
                        <td>{{ dim.weight_pct }}%</td>
                        <td>{{ dim.findings_count }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <!-- Aggregate Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card__label">Total findings</div>
                <div class="stat-card__value">{{ report.score_card.total_findings }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__label">Scan duration</div>
                <div class="stat-card__value">{{ report.analysis_duration_seconds | round(1) }}s</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__label">Generated</div>
                <div class="stat-card__value" style="font-size: 1rem;">{{ generated_at }}</div>
            </div>
        </div>

        <!-- Redaction Notice -->
        <div class="redaction-notice">
            <strong>{{ report.score_card.total_findings }} findings detected.</strong>
            Full details available in the confidential report.
        </div>

        <footer class="footer">
            Spectra v{{ spectra_version }} · Public summary for {{ report.repo_name }} · Generated {{ generated_at }}
        </footer>
    </div>

    <script nonce="{{ csp_nonce }}">
    (function() {
        'use strict';
        var DISCLAIMER_DISMISS_KEY = 'spectra:disclaimer:dismissed';

        function safeSessionGet(key) {
            try { return window.sessionStorage.getItem(key); }
            catch (e) { return null; }
        }
        function safeSessionSet(key, value) {
            try { window.sessionStorage.setItem(key, value); }
            catch (e) { /* private mode or quota — fail open */ }
        }
        function initDisclaimerBanner() {
            var banner = document.getElementById('disclaimer-banner');
            if (!banner) return;
            if (safeSessionGet(DISCLAIMER_DISMISS_KEY) === '1') {
                banner.classList.add('is-dismissed');
            }
            document.addEventListener('click', function(evt) {
                var target = evt.target;
                if (!target || typeof target.closest !== 'function') return;
                var trigger = target.closest('[data-action="dismiss-disclaimer"]');
                if (!trigger) return;
                evt.preventDefault();
                banner.classList.add('is-dismissed');
                safeSessionSet(DISCLAIMER_DISMISS_KEY, '1');
            });
        }
        document.addEventListener('DOMContentLoaded', initDisclaimerBanner);
    })();
    </script>
</body>
</html>
