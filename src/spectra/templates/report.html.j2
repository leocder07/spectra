                            <div class="soc2-control-item {% if ctrl.covered %}soc2-covered{% else %}soc2-gap{% endif %}">
                                <span class="soc2-control-icon">{% if ctrl.covered %}&#x2713;{% else %}&#x2717;{% endif %}</span>
                                <span class="soc2-control-id">{{ ctrl.id }}</span>
                                <span class="soc2-control-desc">{{ ctrl.desc }}</span>
                                {% if ctrl.finding_count > 0 %}
                                <span class="soc2-control-count">{{ ctrl.finding_count }}</span>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </details>
                </div>
                {% endfor %}
            </div>
            <p class="dd-disclaimer">Keyword-based mapping to NIST Cybersecurity Framework 2.0 (6 Functions). Not a formal NIST assessment.</p>
        </section>
        {% endif %}

        <!-- Issue Concentration Analysis -->
        {% if issue_concentration %}
        <section class="dd-section scroll-reveal {% if issue_concentration.rating == 'critical' %}dd-red{% elif issue_concentration.rating == 'concerning' %}dd-amber{% else %}dd-green{% endif %}" id="issue-concentration">
            <div class="section-label">Issue Concentration</div>

            {% set bf_score = issue_concentration.score | default(0) %}
            {% if bf_score >= 70 %}{% set bf_color = 'var(--green)' %}
            {% elif bf_score >= 50 %}{% set bf_color = 'var(--cyan)' %}
            {% elif bf_score >= 30 %}{% set bf_color = 'var(--amber)' %}
            {% else %}{% set bf_color = 'var(--red)' %}{% endif %}

            <div class="bf-header">
                <div class="bf-score-display">
                    <div class="bf-score-num" style="color: {{ bf_color }};"><span class="counter-animate" data-target="{{ bf_score }}">0</span></div>
                    <div class="bf-score-label">distribution score</div>
                </div>
                <div class="ir-rating-badge {% if issue_concentration.rating == 'healthy' %}ir-rating-investment-ready{% elif issue_concentration.rating == 'moderate' %}ir-rating-near-ready{% elif issue_concentration.rating == 'concerning' %}ir-rating-needs-work{% else %}ir-rating-not-ready{% endif %}">
                    {{ issue_concentration.rating | default('unknown') }}
                </div>
                <div class="bf-meta-grid">
                    {% if issue_concentration.concentration is defined %}
                    <div class="bf-meta-item">
                        <div class="bf-meta-value">{{ issue_concentration.concentration }}</div>
                        <div class="bf-meta-label">Gini Coefficient</div>
                    </div>
                    {% endif %}
                    {% if issue_concentration.unique_files is defined %}
                    <div class="bf-meta-item">
                        <div class="bf-meta-value">{{ issue_concentration.unique_files }}</div>
                        <div class="bf-meta-label">Unique Files</div>
                    </div>
                    {% endif %}
                    {% if issue_concentration.total_issues is defined %}
                    <div class="bf-meta-item">
                        <div class="bf-meta-value">{{ issue_concentration.total_issues }}</div>
                        <div class="bf-meta-label">Total Issues</div>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% if issue_concentration.hotspots %}
            <div class="dd-subsection-label" style="margin-top: 0;">Top 10 Hotspot Files</div>
            {% set max_hotspot = issue_concentration.hotspots[0].count if issue_concentration.hotspots else 1 %}
            <ul class="bf-hotspot-list">
                {% for hotspot in issue_concentration.hotspots[:10] %}
                {% set hs_count = hotspot.count | default(0) %}
                {% if hs_count >= 5 %}{% set hs_color = 'var(--red)' %}
                {% elif hs_count >= 3 %}{% set hs_color = 'var(--orange)' %}
                {% elif hs_count >= 2 %}{% set hs_color = 'var(--amber)' %}
                {% else %}{% set hs_color = 'var(--cyan)' %}{% endif %}
                <li class="bf-hotspot-item">
                    <span class="bf-hotspot-rank">{{ loop.index }}</span>
                    <span class="bf-hotspot-count" style="color: {{ hs_color }};">{{ hs_count }}</span>
                    <div class="bf-hotspot-bar">
                        <div class="bf-hotspot-bar-fill" style="width: {{ (hs_count / max_hotspot * 100) | round(0) }}%; background: {{ hs_color }};"></div>
                    </div>
                    <span class="bf-hotspot-path" title="{{ hotspot.file }}">{{ hotspot.file }}</span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
            <p class="dd-disclaimer">Measures finding distribution across files. For contributor-based bus factor analysis, use git blame tools.</p>
        </section>
        {% endif %}

        <!-- Dependency Risk -->
        {% if dependency_risk %}
        <section class="dd-section scroll-reveal {% if dependency_risk.score >= 60 %}dd-red{% elif dependency_risk.score >= 40 %}dd-amber{% else %}dd-green{% endif %}" id="dependency-risk">
            <div class="section-label">Dependency Risk</div>

            {% set dr_score = dependency_risk.score | default(0) %}
            {% if dr_score < 20 %}{% set dr_color = 'var(--green)' %}{% set dr_glow = 'var(--green-glow)' %}
            {% elif dr_score < 40 %}{% set dr_color = 'var(--cyan)' %}{% set dr_glow = 'rgba(6,182,212,0.2)' %}
            {% elif dr_score < 60 %}{% set dr_color = 'var(--amber)' %}{% set dr_glow = 'var(--amber-glow)' %}
            {% else %}{% set dr_color = 'var(--red)' %}{% set dr_glow = 'var(--red-glow)' %}{% endif %}

            <div class="dr-header">
                <div class="dr-gauge"
                     style="background: conic-gradient({{ dr_color }} {{ (dr_score * 3.6) | round(1) }}deg, var(--bg-elevated) 0deg); --gauge-glow: {{ dr_glow }};">
                    <div class="dr-gauge-inner">
                        <span class="dr-gauge-score" style="color: {{ dr_color }};"><span class="counter-animate" data-target="{{ dr_score }}">0</span></span>
                        <span class="dr-gauge-label">risk</span>
                    </div>
                </div>
                <div>
                    <span class="ir-rating-badge {% if dependency_risk.rating == 'low' %}ir-rating-investment-ready{% elif dependency_risk.rating == 'moderate' %}ir-rating-near-ready{% elif dependency_risk.rating == 'elevated' %}ir-rating-needs-work{% elif dependency_risk.rating == 'high' %}ir-rating-significant-gaps{% else %}ir-rating-not-ready{% endif %}">
                        {{ dependency_risk.rating | default('unknown') }} risk
                    </span>
                    <div style="margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary);">
                        {{ dependency_risk.total_dep_findings | default(0) }} dependency findings analyzed
                        {% if dependency_risk.severity_penalty is defined and dependency_risk.severity_penalty > 0 %}
                        <span style="color: var(--text-tertiary);"> &middot; </span>
                        <span style="color: var(--red);">+{{ dependency_risk.severity_penalty }} severity penalty</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            {% if dependency_risk.risk_signals %}
            <div class="dd-subsection-label" style="margin-top: 0;">Risk Signals Detected</div>
            <ul class="dr-signals-list">
                {% for signal in dependency_risk.risk_signals %}
                <li class="dr-signal-item">
                    <span class="dr-signal-keyword">{{ signal.keyword }}</span>
                    <span class="dr-signal-weight">+{{ signal.weight }} pts</span>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--green); margin-top: 1rem;">No dependency risk signals detected</div>
            {% endif %}
        </section>
        {% endif %}

        <!-- License Compliance -->
        {% if license_compliance %}
        <section class="dd-section scroll-reveal" id="license-compliance">
            <div class="section-label">License Compliance</div>

            <div class="dd-coverage-stat">
                {{ license_compliance.unique_licenses | default(0) }} unique license{{ 's' if license_compliance.unique_licenses != 1 else '' }} detected
                <span style="color: var(--text-tertiary);"> &middot; </span>
                {{ license_compliance.total_mentions | default(0) }} total mention{{ 's' if license_compliance.total_mentions != 1 else '' }}
            </div>

            {% if license_compliance.licenses_found %}
            <div class="lc-tags">
                {% set copyleft_licenses = license_compliance.copyleft_risk.copyleft_licenses | default([]) if license_compliance.copyleft_risk is defined else [] %}
                {% for lic, count in license_compliance.licenses_found.items() %}
                <span class="lc-tag {% if lic in copyleft_licenses %}lc-tag-copyleft{% endif %}">
                    {{ lic }}<span class="lc-tag-count">&times;{{ count }}</span>
                </span>
                {% endfor %}
            </div>
            {% else %}
            <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-tertiary); margin-top: 1rem;">No license references found in findings</div>
            {% endif %}

            {% if license_compliance.copyleft_risk is defined and license_compliance.copyleft_risk.has_copyleft %}
            <div class="lc-copyleft-alert">
                Copyleft Risk Detected — The following licenses may restrict distribution:
                <div class="lc-copyleft-list">
                    {% for lic in license_compliance.copyleft_risk.copyleft_licenses %}
                    <span class="lc-tag lc-tag-copyleft">{{ lic }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </section>
        {% endif %}

        <!-- Code Complexity -->
        {% if complexity %}
        {% set cx_max = complexity.max_complexity | default(0) %}
        {% set cx_files = complexity.high_complexity_files %}
        {% if cx_max > 0 or cx_files %}
        <section class="dd-section scroll-reveal {% if complexity.risk_level == 'critical' %}dd-red{% elif complexity.risk_level == 'high' %}dd-red{% elif complexity.risk_level == 'moderate' %}dd-amber{% else %}dd-green{% endif %}" id="complexity">
            <div class="section-label">Code Complexity</div>

            {% if cx_max > 30 %}{% set cx_color = 'var(--red)' %}
            {% elif cx_max > 20 %}{% set cx_color = 'var(--orange)' %}
            {% elif cx_max > 10 %}{% set cx_color = 'var(--amber)' %}
            {% else %}{% set cx_color = 'var(--green)' %}{% endif %}

            {% if cx_max > 0 %}
            <div class="cx-header">
                <div class="cx-stat-block">
                    <div class="cx-stat-num" style="color: {{ cx_color }};">{{ cx_max }}</div>
                    <div class="cx-stat-label">Max Complexity</div>
                </div>
                <div class="cx-stat-block">
                    <div class="cx-stat-num" style="color: var(--text-secondary);">{{ complexity.avg_complexity | default(0) }}</div>
                    <div class="cx-stat-label">Avg Complexity</div>
                </div>
                <div class="cx-stat-block">
                    <div class="cx-stat-num" style="color: var(--amber);">{{ complexity.high_complexity_count | default(0) }}</div>
                    <div class="cx-stat-label">High Complexity Files</div>
                </div>
                <div>
                    <span class="ir-rating-badge {% if complexity.risk_level == 'low' %}ir-rating-investment-ready{% elif complexity.risk_level == 'moderate' %}ir-rating-near-ready{% elif complexity.risk_level == 'high' %}ir-rating-significant-gaps{% elif complexity.risk_level == 'critical' %}ir-rating-not-ready{% else %}ir-rating-needs-work{% endif %}">
                        {{ complexity.risk_level | default('unknown') }} risk
                    </span>
                </div>
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-tertiary); margin-top: -0.5rem; margin-bottom: 0.75rem;">
                Numbers extracted from finding text (e.g. "cyclomatic complexity 18"). Spectra does not yet AST-parse code; these are best-effort signals from what specialists wrote.
            </div>
            {% else %}
            <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary); padding: 0.5rem 0;">
                {{ cx_files | length }} file{% if cx_files | length != 1 %}s{% endif %} flagged for complexity by specialists. No numeric complexity scores were extracted from finding text.
            </div>
            {% endif %}

            {% if cx_files %}
            <div class="dd-subsection-label" style="margin-top: {% if cx_max > 0 %}0{% else %}0.5rem{% endif %};">Files flagged for complexity by specialists</div>
            <ul class="cx-file-list">
                {% for item in cx_files %}
                <li class="cx-file-item">
                    <span class="cx-file-sev badge-{{ item.severity }}">{{ item.severity }}</span>
                    <span class="cx-file-title">{{ item.title }}</span>
                    <span class="cx-file-path" title="{{ item.file }}">{{ item.file }}</span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </section>
        {% endif %}
        {% endif %}

        <!-- ROI Analysis -->
        {% if roi %}
        <section class="dd-section dd-green scroll-reveal" id="roi-analysis">
            <div class="section-label">ROI Analysis</div>

            <div style="background: rgba(34, 197, 94, 0.08); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 10px; padding: 1.5rem 2rem; margin-top: 1rem;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                    <div>
                        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary); margin-bottom: 0.25rem;">This analysis cost</div>
                        <div style="font-family: var(--font-mono); font-size: 1.8rem; font-weight: 700; color: var(--text);">${{ "%.2f" | format(roi.spectra_cost) }}</div>
                    </div>
                    <div>
                        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary); margin-bottom: 0.25rem;">Manual equivalent (${{ roi.engineer_rate }}/hr &times; {{ roi.manual_hours | round(0) | int }}h)</div>
                        <div style="font-family: var(--font-mono); font-size: 1.8rem; font-weight: 700; color: var(--text-secondary);">${{ roi.manual_cost }}</div>
                    </div>
                </div>

                <div style="margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgba(34, 197, 94, 0.15); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--green); font-weight: 600;">Spectra saved you</div>
                        <div style="font-family: var(--font-mono); font-size: 2.2rem; font-weight: 800; color: var(--green); filter: drop-shadow(0 0 12px var(--green-glow));">${{ roi.savings }} <span style="font-size: 1rem; opacity: 0.8;">({{ roi.savings_pct }}%)</span></div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary);">Cost per finding</div>
                        <div style="font-family: var(--font-mono); font-size: 1.4rem; font-weight: 700; color: var(--text-secondary);">${{ "%.2f" | format(roi.cost_per_finding) }}</div>
                    </div>
                </div>
            </div>

            <p class="dd-disclaimer">Based on ${{ roi.engineer_rate }}/hr senior engineer rate and ~{{ roi.manual_hours | round(0) | int }} hours for equivalent manual review. Actual costs vary.</p>
        </section>
        {% endif %}

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-line">
                <a href="https://github.com/leocder07/spectra">spectra</a>
                <span class="sep"> &middot; </span>{{ report.agents_used | length }} agents
                <span class="sep"> &middot; </span>{{ report.analysis_duration_seconds | round(0) | int }}s
                <span class="sep"> &middot; </span>${{ "%.2f" | format(report.total_cost_usd) }}
            </div>
            <div class="footer-line">{{ report.repo_url }}</div>
            <div class="footer-line" style="opacity: 0.5;">{{ generated_at }}</div>
            {% if report.receipt %}
            <div class="footer-line" style="margin-top: 0.75rem; opacity: 0.7; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">
                signed receipt &middot; scan {{ report.receipt.scan_id[:8] }} &middot; key {{ report.receipt.public_key_fingerprint[:8] }}
            </div>
            <div class="footer-line" style="opacity: 0.45; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;">
                verify with: <code>spectra verify &lt;report.json&gt;</code>
            </div>
            {% endif %}
        </footer>
    </div>

    <!-- Keyboard Shortcut Hints -->
    <div class="kb-hint" aria-hidden="true">
        <span class="kb-key">j</span><span class="kb-key">k</span> navigate
        <span class="kb-key">/</span> search
        <span class="kb-key">Esc</span> clear
        <span class="kb-key">Enter</span> expand
    </div>

    <!-- ═══════════════════════════════════════════════════════
         SPECTRA — Premium Interactive JavaScript
         Filters, Search, Counters, Keyboard Nav, Scroll Spy
         ═══════════════════════════════════════════════════════ -->
    <script nonce="{{ csp_nonce }}">
    (function() {
        'use strict';

        /* ─── 1. Radar Chart Rendering ─── */
        function initRadarChart() {
            var polygon = document.getElementById('radar-polygon');
            var pointsGroup = document.getElementById('radar-points');
            var labels = document.querySelectorAll('[id^="radar-label-"]');
            if (!polygon || !labels.length) return;

            var cx = 140, cy = 140, r = 120;
            var n = labels.length;
            var angleStep = (2 * Math.PI) / n;
            var startAngle = -Math.PI / 2;
            var points = [];

            for (var i = 0; i < n; i++) {
                var label = labels[i];
                var score = parseInt(label.getAttribute('data-score') || '0', 10);
                var pct = score / 100;
                var angle = startAngle + (i * angleStep);

                var px = cx + r * pct * Math.cos(angle);
                var py = cy + r * pct * Math.sin(angle);
                points.push(px.toFixed(1) + ',' + py.toFixed(1));

                var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('cx', px.toFixed(1));
                circle.setAttribute('cy', py.toFixed(1));
                circle.setAttribute('r', '4');
                circle.setAttribute('class', 'radar-point');
                pointsGroup.appendChild(circle);

                var lx = cx + (r + 30) * Math.cos(angle);
                var ly = cy + (r + 30) * Math.sin(angle);
                var containerRect = document.getElementById('radar-chart');
                if (containerRect) {
                    var chartW = containerRect.offsetWidth || 280;
                    var chartH = containerRect.offsetHeight || 280;
                    var pctX = (lx / 280) * 100;
                    var pctY = (ly / 280) * 100;
                    label.style.left = pctX + '%';
                    label.style.top = pctY + '%';
                }
            }

            polygon.setAttribute('points', points.join(' '));
        }

        /* ─── 2. Animated Score Counters ─── */
        function animateCounter(el) {
            var raw = el.getAttribute('data-target') || '0';
            var suffix = el.getAttribute('data-suffix') || '';
            var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
            var target = parseFloat(raw);
            if (isNaN(target)) { el.textContent = raw; return; }

            var duration = 1200;
            var start = performance.now();

            function easeOutQuart(t) { return 1 - Math.pow(1 - t, 4); }

            function tick(now) {
                var elapsed = now - start;
                var progress = Math.min(elapsed / duration, 1);
                var val = target * easeOutQuart(progress);

                if (decimals > 0) {
                    el.textContent = val.toFixed(decimals) + suffix;
                } else {
                    el.textContent = Math.round(val) + suffix;
                }

                if (progress < 1) {
                    requestAnimationFrame(tick);
                } else {
                    if (decimals > 0) {
                        el.textContent = target.toFixed(decimals) + suffix;
                    } else {
                        el.textContent = Math.round(target) + suffix;
                    }
                }
            }

            requestAnimationFrame(tick);
        }

        function initCounters() {
            var counters = document.querySelectorAll('.counter-animate');
            if (!('IntersectionObserver' in window)) {
                counters.forEach(function(c) {
                    var t = c.getAttribute('data-target') || '0';
                    var s = c.getAttribute('data-suffix') || '';
                    var d = parseInt(c.getAttribute('data-decimals') || '0', 10);
                    c.textContent = d > 0 ? parseFloat(t).toFixed(d) + s : t + s;
                });
                return;
            }

            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.3 });

            counters.forEach(function(c) { observer.observe(c); });
        }

        /* ─── 3. Scroll-Triggered Fade-In ─── */
        function initScrollReveal() {
            var reveals = document.querySelectorAll('.scroll-reveal');
            if (!reveals.length) return;

            if (!('IntersectionObserver' in window)) {
                reveals.forEach(function(el) { el.classList.add('revealed'); });
                return;
            }

            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('revealed');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

            reveals.forEach(function(el) { observer.observe(el); });
        }

        /* ─── 4. Finding Filter System ─── */
        var filterSeverity = document.getElementById('filter-severity');
        var filterDimension = document.getElementById('filter-dimension');
        var filterSearch = document.getElementById('filter-search');
        var filterCountEl = document.getElementById('filter-count');

        function applyFilters() {
            var sev = filterSeverity ? filterSeverity.value : 'all';
            var dim = filterDimension ? filterDimension.value : 'all';
            var query = filterSearch ? filterSearch.value.toLowerCase().trim() : '';

            var findings = document.querySelectorAll('.finding[data-severity]');
            var visible = 0;
            var total = findings.length;

            findings.forEach(function(f) {
                var matchSev = (sev === 'all') || (f.getAttribute('data-severity') === sev);
                var matchDim = (dim === 'all') || (f.getAttribute('data-dimension') === dim);
                var matchSearch = true;

                if (query) {
                    var title = (f.getAttribute('data-title') || '').toLowerCase();
                    var location = (f.getAttribute('data-location') || '').toLowerCase();
                    var desc = f.querySelector('.finding-description');
                    var descText = desc ? desc.textContent.toLowerCase() : '';
                    var rec = f.querySelector('.finding-recommendation');
                    var recText = rec ? rec.textContent.toLowerCase() : '';
                    matchSearch = title.indexOf(query) !== -1 ||
                                  location.indexOf(query) !== -1 ||
                                  descText.indexOf(query) !== -1 ||
                                  recText.indexOf(query) !== -1;
                }

                if (matchSev && matchDim && matchSearch) {
                    f.classList.remove('filter-hidden');
                    visible++;
                } else {
                    f.classList.add('filter-hidden');
                }
            });

            /* Show/hide empty section messages */
            var sections = document.querySelectorAll('.findings-section[data-dimension]');
            sections.forEach(function(sec) {
                var visibleInSection = sec.querySelectorAll('.finding[data-severity]:not(.filter-hidden)');
                if (visibleInSection.length === 0 && total > 0 && (sev !== 'all' || dim !== 'all' || query)) {
                    sec.classList.add('filter-empty');
                } else {
                    sec.classList.remove('filter-empty');
                }
            });

            if (filterCountEl) {
                if (sev !== 'all' || dim !== 'all' || query) {
                    filterCountEl.textContent = visible + ' / ' + total;
                } else {
                    filterCountEl.textContent = '';
                }
            }

            /* Reset keyboard nav index on filter change */
            kbIndex = -1;

            /* Reset expand/collapse state for consistency */
            if (typeof allExpanded !== 'undefined' && allExpanded) {
                allExpanded = false;
                if (btnExpandAll) btnExpandAll.textContent = 'Expand All';
            }
        }

        if (filterSeverity) filterSeverity.addEventListener('change', applyFilters);
        if (filterDimension) filterDimension.addEventListener('change', applyFilters);
        if (filterSearch) filterSearch.addEventListener('input', applyFilters);

        /* ─── 5. Expand/Collapse All ─── */
        var btnExpandAll = document.getElementById('btn-expand-all');
        var allExpanded = false;

        if (btnExpandAll) {
            btnExpandAll.addEventListener('click', function() {
                var findings = document.querySelectorAll('.finding[data-severity]:not(.filter-hidden)');
                allExpanded = !allExpanded;
                findings.forEach(function(f) {
                    if (allExpanded) {
                        f.classList.add('expanded');
                    } else {
                        f.classList.remove('expanded');
                    }
                });
                btnExpandAll.textContent = allExpanded ? 'Collapse All' : 'Expand All';
                btnExpandAll.classList.toggle('active', allExpanded);
            });
        }

        /* ─── 6. Copy Finding to Clipboard ─── */
        window.copyFinding = function(btn) {
            var finding = btn.closest('.finding');
            if (!finding) return;

            var severity = finding.getAttribute('data-severity') || '';
            var title = (finding.querySelector('.finding-title') || {}).textContent || '';
            var location = (finding.querySelector('.finding-location') || {}).textContent || '';
            var desc = (finding.querySelector('.finding-description') || {}).textContent || '';
            var rec = (finding.querySelector('.finding-recommendation') || {}).textContent || '';

            var text = [
                '[' + severity.toUpperCase() + '] ' + title.trim(),
                'Location: ' + location.trim(),
                '',
                desc.trim(),
                '',
                rec.trim()
            ].join('\n');

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function() {
                    btn.textContent = 'Copied';
                    btn.classList.add('copied');
                    setTimeout(function() {
                        btn.textContent = 'Copy';
                        btn.classList.remove('copied');
                    }, 2000);
                });
            } else {
                /* Fallback for older browsers */
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.left = '-9999px';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch(e) {}
                document.body.removeChild(ta);
                btn.textContent = 'Copied';
                btn.classList.add('copied');
                setTimeout(function() {
                    btn.textContent = 'Copy';
                    btn.classList.remove('copied');
                }, 2000);
            }
        };

        /* ─── 6b. Event Delegation (CSP-safe replacement for inline onclick) ─── */
        document.addEventListener('click', function(e) {
            /* Copy button takes precedence over the row toggle */
            var copyBtn = e.target.closest('[data-action="copy-finding"]');
            if (copyBtn) {
                e.stopPropagation();
                window.copyFinding(copyBtn);
                return;
            }
            /* Toggle row expand */
            var row = e.target.closest('[data-toggle="finding"]');
            if (row) {
                row.classList.toggle('expanded');
                row.setAttribute('aria-expanded', row.classList.contains('expanded') ? 'true' : 'false');
            }
        });

        /* Keyboard activation on focused finding (Space / Enter) */
        document.addEventListener('keydown', function(e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            var row = e.target.closest && e.target.closest('[data-toggle="finding"]');
            if (!row || row !== document.activeElement) return;
            e.preventDefault();
            row.classList.toggle('expanded');
            row.setAttribute('aria-expanded', row.classList.contains('expanded') ? 'true' : 'false');
        });

        /* ─── 7. Keyboard Navigation ─── */
        var kbIndex = -1;

        function getVisibleFindings() {
            return Array.from(document.querySelectorAll('.finding[data-severity]:not(.filter-hidden)'));
        }

        function setKbActive(index) {
            var findings = getVisibleFindings();
            if (findings.length === 0) return;

            /* Remove previous active */
            findings.forEach(function(f) { f.classList.remove('kb-active'); });

            /* Clamp index */
            if (index < 0) index = 0;
            if (index >= findings.length) index = findings.length - 1;
            kbIndex = index;

            var target = findings[kbIndex];
            target.classList.add('kb-active');
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        document.addEventListener('keydown', function(e) {
            /* Ignore when typing in inputs */
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
                if (e.key === 'Escape') {
                    e.target.blur();
                    if (filterSearch) {
                        filterSearch.value = '';
                        applyFilters();
                    }
                }
                return;
            }

            switch (e.key) {
                case 'j':
                    e.preventDefault();
                    setKbActive(kbIndex + 1);
                    break;
                case 'k':
                    e.preventDefault();
                    setKbActive(kbIndex - 1);
                    break;
                case '/':
                    e.preventDefault();
                    if (filterSearch) filterSearch.focus();
                    break;
                case 'Escape':
                    e.preventDefault();
                    /* Clear search and filters */
                    if (filterSearch) filterSearch.value = '';
                    if (filterSeverity) filterSeverity.value = 'all';
                    if (filterDimension) filterDimension.value = 'all';
                    applyFilters();
                    /* Clear kb active */
                    document.querySelectorAll('.finding.kb-active').forEach(function(f) {
                        f.classList.remove('kb-active');
                    });
                    kbIndex = -1;
                    break;
                case 'Enter':
                    e.preventDefault();
                    var findings = getVisibleFindings();
                    if (kbIndex >= 0 && kbIndex < findings.length) {
                        findings[kbIndex].classList.toggle('expanded');
                    }
                    break;
            }
        });

        /* ─── 8. Smooth Scroll Spy ─── */
        function initScrollSpy() {
            var nav = document.getElementById('section-nav');
            if (!nav) return;

            var links = nav.querySelectorAll('a[href^="#"]');
            if (!links.length) return;

            var sections = [];
            links.forEach(function(link) {
                var id = link.getAttribute('href').slice(1);
                var section = document.getElementById(id);
                if (section) {
                    sections.push({ el: section, link: link });
                }
            });

            if (!sections.length) return;

            var ticking = false;

            function updateSpy() {
                var scrollY = window.scrollY || window.pageYOffset;
                var offset = 120;
                var current = null;

                for (var i = sections.length - 1; i >= 0; i--) {
                    if (sections[i].el.offsetTop - offset <= scrollY) {
                        current = sections[i];
                        break;
                    }
                }

                links.forEach(function(l) { l.classList.remove('scroll-active'); });
                if (current) {
                    current.link.classList.add('scroll-active');
                }
                ticking = false;
            }

            window.addEventListener('scroll', function() {
                if (!ticking) {
                    requestAnimationFrame(updateSpy);
                    ticking = true;
                }
            }, { passive: true });

            /* Initial check */
            updateSpy();
        }

        /* ─── 9. Disclaimer Banner Dismissal (CSP-safe) ─── */
        var DISCLAIMER_DISMISS_KEY = 'spectra:disclaimer:dismissed';

        function safeSessionGet(key) {
            try { return window.sessionStorage.getItem(key); }
            catch (e) { return null; }
        }

        function safeSessionSet(key, value) {
            try { window.sessionStorage.setItem(key, value); }
            catch (e) { /* private mode or quota — fail open */ }
        }

        function initDisclaimerBanner() {
            var banner = document.getElementById('disclaimer-banner');
            if (!banner) return;

            if (safeSessionGet(DISCLAIMER_DISMISS_KEY) === '1') {
                banner.classList.add('is-dismissed');
            }

            /* Event delegation: no inline handlers, no per-element listeners.
               Survives any future banners that reuse data-action="dismiss-disclaimer". */
            document.addEventListener('click', function(evt) {
                var target = evt.target;
                if (!target || typeof target.closest !== 'function') return;
                var trigger = target.closest('[data-action="dismiss-disclaimer"]');
                if (!trigger) return;
                evt.preventDefault();
                banner.classList.add('is-dismissed');
                safeSessionSet(DISCLAIMER_DISMISS_KEY, '1');
            });
        }

        /* ─── Initialize Everything ─── */
        document.addEventListener('DOMContentLoaded', function() {
            initRadarChart();
            initCounters();
            initScrollReveal();
            initScrollSpy();
            initDisclaimerBanner();
        });

    })();
    </script>
</body>
</html>
