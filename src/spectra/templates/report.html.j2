                    {% set pci_rs = pci_dss.readiness_score | default(0) | round(1) %}
                    <span class="soc2-pct" style="color: {% if pci_rs >= 75 %}var(--green){% elif pci_rs >= 50 %}var(--cyan){% elif pci_rs > 0 %}var(--amber){% else %}var(--red){% endif %};">{{ pci_rs }}%</span>
                    <span class="soc2-pct-label">control coverage</span>
                </div>
                <div class="soc2-readiness-stats">
                    {{ pci_dss.covered_controls | default(0) }} of {{ pci_dss.total_controls | default(0) }} controls addressed<br>
                    {{ pci_dss.gap_controls | default([]) | length }} gaps &middot; {{ pci_dss.total_mapped | default(0) }} findings mapped
                </div>
            </div>

            {% if pci_dss.readiness_score is defined and pci_dss.readiness_score < 10 %}
            <p class="dd-empty-note">PCI DSS mapping requires findings with Req 6-specific keywords. Low coverage typically means the analysis did not surface relevant language.</p>
            {% endif %}

            <div class="dd-bar-track" style="height: 8px; margin-bottom: 1.5rem;">
                <div class="dd-bar-fill" style="width: {{ pci_dss.readiness_score | default(0) }}%; background: {% if pci_rs >= 75 %}var(--green){% elif pci_rs >= 50 %}var(--cyan){% elif pci_rs > 0 %}var(--amber){% else %}var(--red){% endif %};"></div>
            </div>

            <div class="soc2-grid">
                {% for cc in pci_dss.cc_categories | default([]) %}
                <div class="soc2-criterion">
                    <details>
                        <summary class="soc2-criterion-header">
                            <span class="soc2-criterion-label">{{ cc.id }}: {{ cc.title }}</span>
                            {% if cc.has_critical %}
                            <span class="soc2-criterion-count soc2-count-crit">{{ cc.covered_count }}/{{ cc.total_count }}</span>
                            {% elif cc.covered_count > 0 %}
                            <span class="soc2-criterion-count soc2-count-warn">{{ cc.covered_count }}/{{ cc.total_count }}</span>
                            {% else %}
                            <span class="soc2-criterion-count soc2-count-ok">0/{{ cc.total_count }}</span>
                            {% endif %}
                        </summary>

                        <div class="dd-bar-track" style="height: 6px; margin-top: 0.5rem;">
                            {% set cpct = cc.coverage_pct | default(0) %}
                            <div class="dd-bar-fill" style="width: {{ cpct }}%; background: {% if cpct >= 75 %}var(--green){% elif cpct >= 50 %}var(--cyan){% elif cpct > 0 %}var(--amber){% else %}var(--red){% endif %};"></div>
                        </div>

                        <div class="soc2-controls-list">
                            {% for ctrl in cc.controls | default([]) %}
                            <div class="soc2-control-item {% if ctrl.covered %}soc2-covered{% else %}soc2-gap{% endif %}">
                                <span class="soc2-control-icon">{% if ctrl.covered %}&#x2713;{% else %}&#x2717;{% endif %}</span>
                                <span class="soc2-control-id">{{ ctrl.id }}</span>
                                <span class="soc2-control-desc">{{ ctrl.desc }}</span>
                                {% if ctrl.finding_count > 0 %}
                                <span class="soc2-control-count">{{ ctrl.finding_count }}</span>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </details>
                </div>
                {% endfor %}
            </div>
            <p class="dd-disclaimer">Keyword-based mapping to PCI DSS 4.0 Requirement 6 (Secure Systems &amp; Software). Not a formal PCI assessment.</p>
        </section>
        {% endif %}

        <!-- NIST CSF 2.0 Readiness -->
        {% if nist_csf %}
        <section class="dd-section scroll-reveal" id="nist-csf-readiness">
            <div class="section-label">NIST CSF 2.0</div>

            <div class="compliance-disclaimer">
                <span class="compliance-disclaimer-icon">&#x26A0;</span>
                <span>Automated heuristic — not a substitute for formal NIST CSF assessment. Findings are mapped by keyword analysis, not control evidence evaluation.</span>
            </div>

            <div class="soc2-readiness-header">
                <div class="soc2-readiness-score">
                    {% set nist_rs = nist_csf.readiness_score | default(0) | round(1) %}
                    <span class="soc2-pct" style="color: {% if nist_rs >= 75 %}var(--green){% elif nist_rs >= 50 %}var(--cyan){% elif nist_rs > 0 %}var(--amber){% else %}var(--red){% endif %};">{{ nist_rs }}%</span>
                    <span class="soc2-pct-label">function coverage</span>
                </div>
                <div class="soc2-readiness-stats">
                    {{ nist_csf.covered_controls | default(0) }} of {{ nist_csf.total_controls | default(0) }} categories addressed<br>
                    {{ nist_csf.gap_controls | default([]) | length }} gaps &middot; {{ nist_csf.total_mapped | default(0) }} findings mapped
                </div>
            </div>

            {% if nist_csf.readiness_score is defined and nist_csf.readiness_score < 10 %}
            <p class="dd-empty-note">NIST CSF mapping requires findings with function-specific keywords. Low coverage typically means the analysis did not surface relevant language.</p>
            {% endif %}

            <div class="dd-bar-track" style="height: 8px; margin-bottom: 1.5rem;">
                <div class="dd-bar-fill" style="width: {{ nist_csf.readiness_score | default(0) }}%; background: {% if nist_rs >= 75 %}var(--green){% elif nist_rs >= 50 %}var(--cyan){% elif nist_rs > 0 %}var(--amber){% else %}var(--red){% endif %};"></div>
            </div>

            <div class="soc2-grid">
                {% for cc in nist_csf.cc_categories | default([]) %}
                <div class="soc2-criterion">
                    <details>
                        <summary class="soc2-criterion-header">
                            <span class="soc2-criterion-label">{{ cc.id }}: {{ cc.title }}</span>
                            {% if cc.has_critical %}
                            <span class="soc2-criterion-count soc2-count-crit">{{ cc.covered_count }}/{{ cc.total_count }}</span>
                            {% elif cc.covered_count > 0 %}
                            <span class="soc2-criterion-count soc2-count-warn">{{ cc.covered_count }}/{{ cc.total_count }}</span>
                            {% else %}
                            <span class="soc2-criterion-count soc2-count-ok">0/{{ cc.total_count }}</span>
                            {% endif %}
                        </summary>

                        <div class="dd-bar-track" style="height: 6px; margin-top: 0.5rem;">
                            {% set cpct = cc.coverage_pct | default(0) %}
                            <div class="dd-bar-fill" style="width: {{ cpct }}%; background: {% if cpct >= 75 %}var(--green){% elif cpct >= 50 %}var(--cyan){% elif cpct > 0 %}var(--amber){% else %}var(--red){% endif %};"></div>
                        </div>

